    <AssemblyName>Maestro Composition Lab</AssemblyName><RootNamespace>MaestroDesktop</RootNamespace>
    <LangVersion>latest</LangVersion><PlatformTarget>x64</PlatformTarget>
    <Version>3.0.0</Version><FileVersion>3.0.0.0</FileVersion>
